# ==============================================================================
st.set_page_config(
    page_title="ScamShield AI — Verify Before You Pay",
    page_icon="🛡️",
    layout="wide",
    initial_sidebar_state="expanded"
)

# Custom CSS for a modern cybersecurity dashboard look
st.markdown("""
    <style>
